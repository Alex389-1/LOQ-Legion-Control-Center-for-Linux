[Unit]
Description=LOQ Control Center
Documentation=https://github.com/loq-control
After=graphical-session.target network.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/loq-control
Restart=on-failure
RestartSec=5
# Avoid restart loops if GPU is not present
StartLimitBurst=3
StartLimitIntervalSec=60

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
